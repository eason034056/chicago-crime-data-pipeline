# Copy this file to .env and fill in your course Snowflake account.
# .env is gitignored. Never commit a private key.

SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_user
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CHICAGO_CRIME
SNOWFLAKE_SCHEMA=ANALYTICS

# Optional. The Chicago API works without a token; a token raises the rate limit.
SODA_APP_TOKEN=
